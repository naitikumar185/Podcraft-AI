# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Get a free key at https://aistudio.google.com/apikey
# (Optional here — the app also lets you paste it in the sidebar at runtime.)
GOOGLE_API_KEY=

# Razorpay TEST MODE keys — sign up free at https://dashboard.razorpay.com/signup
# No business verification is needed to get Test Mode keys.
# Dashboard > Settings > API Keys > Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
